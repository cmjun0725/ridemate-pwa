{
  "profile": "product-admin",
  "sourceRoots": ["src"],
  "locale": "ko-KR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Select/Listbox", "Date", "Form", "Scrollbar", "Toast", "CRUD"],
  "ownership": {
    "Select/Listbox": "authored",
    "Date": "native",
    "Form": "application",
    "Scrollbar": "global",
    "Toast": "shared",
    "CRUD": "service"
  },
  "requiredCommands": ["build", "lint", "unit"],
  "commands": {
    "build": "npm run build",
    "lint": "npm run lint",
    "unit": "npm test -- --run"
  }
}
