rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function rideMember(rideId) { return signedIn() && exists(/databases/$(database)/documents/rideMembers/$(rideId + '_' + request.auth.uid)); }
    match /users/{userId} { allow read: if signedIn(); allow create, update: if owner(userId); allow delete: if false; }
    match /courses/{courseId} { allow read: if true; allow create: if signedIn(); allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid; }
    match /rides/{rideId} { allow read: if true; allow create: if signedIn() && request.resource.data.hostId == request.auth.uid; allow update, delete: if signedIn() && resource.data.hostId == request.auth.uid; }
    match /stops/{stopId} { allow read: if true; allow create, update, delete: if signedIn() && get(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data.hostId == request.auth.uid; }
    match /rideMembers/{memberId} { allow read: if signedIn(); allow write: if false; }
    match /votes/{voteId} { allow read: if signedIn() && rideMember(resource.data.rideId); allow write: if false; }
    match /noShowRecords/{recordId} { allow read: if signedIn() && (resource.data.riderId == request.auth.uid || request.auth.token.admin == true); allow write: if false; }
    match /deviceTokens/{tokenId} { allow read: if false; allow create, update, delete: if signedIn() && request.resource.data.userId == request.auth.uid; }
  }
}
