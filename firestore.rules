rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    function rideMember(rideId) { return signedIn() && exists(/databases/$(database)/documents/rideMembers/$(rideId + '_' + request.auth.uid)); }
    match /users/{userId} { allow read: if owner(userId) || admin(); allow create: if owner(userId) && !request.resource.data.keys().hasAny(['role', 'status', 'noShowCount']); allow update: if owner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'noShowCount', 'moderationReason']) || admin(); allow delete: if false; }
    match /courses/{courseId} { allow read: if resource.data.visibility == 'public' || (signedIn() && resource.data.createdBy == request.auth.uid) || admin(); allow create, update, delete: if false; }
    match /rides/{rideId} { allow read: if resource.data.visibility == 'public' && resource.data.status != '숨김' || (signedIn() && resource.data.hostId == request.auth.uid) || admin(); allow write: if false; }
    match /stops/{stopId} { allow read: if true; allow write: if false; }
    match /rideMembers/{memberId} { allow read: if signedIn(); allow write: if false; }
    match /votes/{voteId} { allow read: if signedIn() && rideMember(resource.data.rideId); allow write: if false; }
    match /noShowRecords/{recordId} { allow read: if signedIn() && (resource.data.riderId == request.auth.uid || request.auth.token.admin == true); allow write: if false; }
    match /deviceTokens/{tokenId} { allow read: if false; allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid; allow delete: if signedIn() && resource.data.userId == request.auth.uid; }
    match /moderationReports/{reportId} { allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid; allow read, update: if admin(); allow delete: if false; }
    match /auditLogs/{logId} { allow read: if admin(); allow write: if false; }
    match /aiRateLimits/{limitId} { allow read, write: if false; }
    match /rideMessages/{messageId} { allow read, write: if false; }
    match /userBlocks/{blockId} { allow read, write: if false; }
    match /rideFavorites/{favoriteId} { allow read, write: if false; }
    match /rideReviews/{reviewId} { allow read, write: if false; }
    match /liveLocations/{locationId} { allow read, write: if false; }
    match /rideArchives/{archiveId} { allow read, write: if false; }
    match /productEvents/{eventId} { allow read, write: if false; }
  }
}
